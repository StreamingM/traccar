# Base de datos PostgreSQL (la usaremos para usuarios, roles, permisos, CRM)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=plataforma_gps_crm
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Base de datos Traccar (solo lectura desde el backend para relaciones)
TRACCAR_DATABASE_HOST=localhost
TRACCAR_DATABASE_PORT=5432
TRACCAR_DATABASE_NAME=traccar
TRACCAR_DATABASE_USER=traccar
TRACCAR_DATABASE_PASSWORD=traccar

# JWT / Autenticación
JWT_SECRET=tu_secreto_jwt_muy_largo_y_seguro_aqui_12345
JWT_EXPIRATION=7d

# API Traccar (motor GPS)
TRACCAR_API_URL=http://localhost:8082
TRACCAR_API_USERNAME=admin
TRACCAR_API_PASSWORD=admin

# Servidor backend
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Email (para notificaciones, recuperar contraseña, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
